{
  "name": "@huntclub/web",
  "version": "0.0.0",
  "private": true,
  "description": "Club web admin page (Vite + React), served from S3 + CloudFront by infra's Web stack.",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "build:kit": "vite build --configLoader runner --mode kit --outDir dist-kit",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner"
  },
  "dependencies": {
    "@huntclub/design": "*",
    "@huntclub/mesh": "*",
    "@huntclub/shared": "*",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "lucide-react": "1.72.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "jsdom": "31.0.1",
    "typescript": "~6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}

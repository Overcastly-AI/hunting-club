{
  "name": "@huntclub/design",
  "version": "0.0.0",
  "private": true,
  "description": "Design D tokens (colors, type scale, sizes, radii, spacing), the web CSS generated from them and the Archivo web font, shared by the app, the club admin and the public site. No React Native or DOM code.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./colors": "./src/colors.ts",
    "./fonts/*": "./fonts/*",
    "./png": "./scripts/png.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "jest",
    "icons": "node ../../scripts/run-ts.mjs scripts/icons.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/jest": "30.0.0",
    "@types/node": "^22.20.7",
    "jest": "~30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  }
}
